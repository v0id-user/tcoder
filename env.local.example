# =============================================================================
# Local Development Environment Variables
# =============================================================================
# Copy to .env for docker-compose (fly-worker)
# Copy to .dev.vars for wrangler dev (Cloudflare Worker)
#
# For local dev, BOTH services use the local SRH proxy:
#   UPSTASH_REDIS_REST_URL=http://localhost:8079
#   UPSTASH_REDIS_REST_TOKEN=local_dev_token
# =============================================================================

# =============================================================================
# Redis - LOCAL (SRH proxy running in docker-compose)
# =============================================================================
# These are pre-configured for local development.
# The SRH proxy emulates the Upstash HTTP API.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local_dev_token

# =============================================================================
# R2 Configuration - REQUIRED - FILL THESE IN
# =============================================================================
# Get these from Cloudflare Dashboard > R2 > Manage API Tokens
#
# IMPORTANT: The API token MUST have:
#   - READ access to the INPUT bucket (for downloading source videos)
#   - WRITE access to the OUTPUT bucket (for uploading transcoded videos)
#
# To create an API token with correct permissions:
# 1. Go to Cloudflare Dashboard > R2 > Overview
# 2. Click "Manage R2 API Tokens"
# 3. Create a new token with:
#    - Object Read access to INPUT bucket
#    - Object Read & Write access to OUTPUT bucket
# =============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 Bucket Names (both required)
# INPUT bucket: where source videos are uploaded
# OUTPUT bucket: where transcoded videos are stored
R2_INPUT_BUCKET_NAME=tcoder-input
R2_OUTPUT_BUCKET_NAME=tcoder-output

# =============================================================================
# Fly.io - OPTIONAL (only needed if spawning real machines in production)
# =============================================================================
# Not required for local development where Docker worker runs continuously.
FLY_API_TOKEN=
FLY_APP_NAME=fly-tcoder-ffmpeg-worker-31657fa
FLY_REGION=fra
