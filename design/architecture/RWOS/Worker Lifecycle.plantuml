@startuml RWOS Worker Lifecycle
!theme plain
skinparam stateFontSize 12

title Worker Lifecycle - Indefinite Polling

[*] --> Starting : Machine started\n(Fly API or reused)

state Starting {
    Starting : Connect to Redis
    Starting : initializeWorker()
    Starting : HSET machines:pool (running)
}

Starting --> Polling : Pool entry created

state Polling {
    Polling : ZPOPMIN jobs:pending
    Polling : Update lastActiveAt
}

Polling --> Processing : Job found

state Processing {
    Processing : Download from R2
    Processing : FFmpeg transcode
    Processing : Upload to R2
    Processing : Update job status
    Processing : Send webhook
}

Processing --> Polling : Job complete\nstate = running

Polling --> Idle : No job available

state Idle {
    Idle : HSET state = idle
    Idle : Sleep POLL_INTERVAL (5s)
}

Idle --> Polling : Continue polling

Idle --> Stopped : Cron detects\nidle > 5 min

state Stopped {
    Stopped : Fly API stop
    Stopped : SADD machines:stopped
    Stopped : HSET state = stopped
}

Stopped --> [*] : Available for reuse

note right of Polling
  **Poll Loop (infinite):**
  while (true) {
    job = ZPOPMIN
    if (!job) { idle; sleep }
    else { process(job) }
  }
end note

note right of Stopped
  **Cron (every minute):**
  Scans machines:pool
  Stops idle > 5 min
  Cleans stale entries
end note

@enduml
