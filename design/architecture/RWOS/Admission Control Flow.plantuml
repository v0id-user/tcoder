@startuml RWOS Admission Control Flow
!theme plain
skinparam boxPadding 10
skinparam participantPadding 8
autonumber "<b>[0]"

title Admission Control - Spawn Worker Flow

participant CP as "Control Plane"
database Redis as "Upstash Redis"
participant Fly as "Fly Machines API"

== Try Reuse Stopped Machine ==
CP -> Redis: SPOP machines:stopped
Redis --> CP: machine_id or null

alt machine_id found
    note right of CP: Reuse existing machine
    CP -> Fly: POST machines/{id}/start
    Fly --> CP: started
    CP -> Redis: SREM machines:stopped\nHSET machines:pool (running)
    CP --> CP: Return machine_id
else no stopped machines
    == Atomic Capacity Check ==
    CP -> Redis: INCR counters:active_machines
    Redis --> CP: slot_number

    alt slot > MAX_MACHINES
        note right of CP: Capacity full
        CP -> Redis: DECR counters:active_machines
        CP --> CP: Return CapacityFull
    else slot <= MAX_MACHINES
        note right of CP: Slot acquired

        == Create Machine ==
        CP -> Fly: POST machines/create
        note right of Fly: Retry on 429/5xx\nwith exp backoff

        alt success
            Fly --> CP: machine_id
            CP -> Redis: HSET machines:pool (running)
            CP --> CP: Return machine_id
        else failed after retries
            CP -> Redis: DECR counters:active_machines
            CP --> CP: Return error
        end
    end
end

@enduml
