@startuml Redis Worker Orchestration System
!theme plain
skinparam defaultTextAlignment center
skinparam padding 15
skinparam nodesep 60

title RWOS - Redis Worker Orchestration System

left to right direction

rectangle "**Control Plane**\nCloudflare Worker\n\n//API//\n//Admission//\n//Spawner//\n//Cron//" as CP #e3f2fd

rectangle "**State Store**\nUpstash Redis\n\n//jobs:pending//\n//jobs:status//\n//machines:pool//" as SS #fff8e1

rectangle "**Compute**\nFly.io\n\n//FFmpeg Workers//\n//Poll indefinitely//\n//Stop when idle//" as WP #fff3e0

storage "**R2**\nStorage" as R2 #f3e5f5

CP --> SS : enqueue\njobs
SS --> WP : poll\n& claim
WP --> R2 : transcode
WP ..> CP : webhook

@enduml
